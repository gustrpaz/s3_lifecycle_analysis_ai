{
  "lifecycle_rules_collection": [
    {
      "scenario": "tiered-storage",
      "description": "Progressiva transição para classes de armazenamento mais baratas",
      "Rules": [
        {
          "ID": "LogsProgressiveTiering",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "logs/"
          },
          "Transitions": [
            {
              "Days": 30,
              "StorageClass": "STANDARD_IA"
            },
            {
              "Days": 90,
              "StorageClass": "GLACIER"
            },
            {
              "Days": 180,
              "StorageClass": "DEEP_ARCHIVE"
            }
          ],
          "Expiration": {
            "Days": 2555
          }
        }
      ]
    },
    {
      "scenario": "backup-retention",
      "description": "Política de retenção de backups com limpeza automática",
      "Rules": [
        {
          "ID": "DeleteOldBackups",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "backups/"
          },
          "Expiration": {
            "Days": 90
          }
        },
        {
          "ID": "ArchiveMonthlyBackups",
          "Status": "Enabled",
          "Filter": {
            "And": {
              "Prefix": "backups/monthly/",
              "Tags": [
                {
                  "Key": "type",
                  "Value": "monthly"
                }
              ]
            }
          },
          "Transitions": [
            {
              "Days": 30,
              "StorageClass": "GLACIER"
            }
          ]
        }
      ]
    },
    {
      "scenario": "temp-files-cleanup",
      "description": "Limpeza automática de arquivos temporários",
      "Rules": [
        {
          "ID": "DeleteTempFiles",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "temp/"
          },
          "Expiration": {
            "Days": 7
          }
        },
        {
          "ID": "AbortIncompleteUploads",
          "Status": "Enabled",
          "Filter": {},
          "AbortIncompleteMultipartUpload": {
            "DaysAfterInitiation": 7
          }
        }
      ]
    },
    {
      "scenario": "versioned-bucket",
      "description": "Política para bucket com versionamento habilitado",
      "Rules": [
        {
          "ID": "ArchiveOldVersions",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "documents/"
          },
          "NoncurrentVersionTransitions": [
            {
              "NoncurrentDays": 30,
              "StorageClass": "STANDARD_IA"
            },
            {
              "NoncurrentDays": 90,
              "StorageClass": "GLACIER"
            }
          ],
          "NoncurrentVersionExpiration": {
            "NoncurrentDays": 365
          }
        }
      ]
    },
    {
      "scenario": "tag-based-routing",
      "description": "Política baseada em tags de objetos",
      "Rules": [
        {
          "ID": "RetainBusinessCritical",
          "Status": "Enabled",
          "Filter": {
            "Tag": {
              "Key": "retention",
              "Value": "critical"
            }
          },
          "Expiration": {
            "Days": 2555
          }
        },
        {
          "ID": "DeleteEphemeral",
          "Status": "Enabled",
          "Filter": {
            "Tag": {
              "Key": "retention",
              "Value": "ephemeral"
            }
          },
          "Expiration": {
            "Days": 30
          }
        },
        {
          "ID": "ArchiveAnalytics",
          "Status": "Enabled",
          "Filter": {
            "Tag": {
              "Key": "data-type",
              "Value": "analytics"
            }
          },
          "Transitions": [
            {
              "Days": 60,
              "StorageClass": "GLACIER"
            }
          ]
        }
      ]
    },
    {
      "scenario": "large-files-optimization",
      "description": "Otimização para arquivos grandes",
      "Rules": [
        {
          "ID": "ArchiveLargeObjects",
          "Status": "Enabled",
          "Filter": {
            "And": {
              "Prefix": "media/",
              "ObjectSizeLessThan": 1099511627776
            }
          },
          "Transitions": [
            {
              "Days": 45,
              "StorageClass": "GLACIER"
            }
          ]
        }
      ]
    },
    {
      "scenario": "mixed-policy",
      "description": "Política mista com múltiplos critérios e ações",
      "Rules": [
        {
          "ID": "DeleteIncompleteMultipart",
          "Status": "Enabled",
          "Filter": {},
          "AbortIncompleteMultipartUpload": {
            "DaysAfterInitiation": 14
          }
        },
        {
          "ID": "ExpirePreviousVersions",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "archive/"
          },
          "NoncurrentVersionExpiration": {
            "NoncurrentDays": 180
          }
        },
        {
          "ID": "TransitionCurrentVersions",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "archive/"
          },
          "Transitions": [
            {
              "Days": 60,
              "StorageClass": "STANDARD_IA"
            },
            {
              "Days": 120,
              "StorageClass": "DEEP_ARCHIVE"
            }
          ],
          "Expiration": {
            "Days": 2920
          }
        }
      ]
    },
    {
      "scenario": "disabled-expiration-only",
      "description": "Regra desabilitada com expiração, que não executa qualquer ação",
      "Rules": [
        {
          "ID": "OldExportDisabled",
          "Status": "Disabled",
          "Filter": {
            "Prefix": "exports/old/"
          },
          "Expiration": {
            "Days": 180
          }
        }
      ]
    },
    {
      "scenario": "disabled-with-active-fallback",
      "description": "Regra ruim desabilitada e regra boa habilitada para o mesmo prefixo",
      "Rules": [
        {
          "ID": "DisabledBadArchive",
          "Status": "Disabled",
          "Filter": {
            "Prefix": "archive/"
          },
          "Transitions": [
            {
              "Days": 10,
              "StorageClass": "STANDARD_IA"
            }
          ]
        },
        {
          "ID": "CorrectArchiveRule",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "archive/"
          },
          "Transitions": [
            {
              "Days": 30,
              "StorageClass": "STANDARD_IA"
            },
            {
              "Days": 120,
              "StorageClass": "GLACIER"
            }
          ]
        }
      ]
    },
    {
      "scenario": "it-plus-standard-ia-redundant",
