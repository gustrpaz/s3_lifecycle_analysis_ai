        }
      ]
    },
    {
      "scenario": "disabled-conflicting-rules",
      "description": "Regra ruim desabilitada, mas ainda assim registrada no conjunto e deve gerar alerta de disabled",
      "Rules": [
        {
          "ID": "DisabledConflictRule",
          "Status": "Disabled",
          "Filter": {
            "Prefix": "conflicts/"
          },
          "Transitions": [
            {
              "Days": 30,
              "StorageClass": "STANDARD_IA"
            },
            {
              "Days": 60,
              "StorageClass": "STANDARD_IA"
            }
          ]
        },
        {
          "ID": "ConflictFallbackRule",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "conflicts/"
          },
          "Transitions": [
            {
              "Days": 30,
              "StorageClass": "GLACIER"
            }
          ]
        }
      ]
    },
    {
      "scenario": "valid-object-size-gated-glacier",
      "description": "Transição correta para Glacier com filtro de tamanho mínimo e expiração compatível",
      "Rules": [
        {
          "ID": "ObjectSizeGatedGlacier",
          "Status": "Enabled",
          "Filter": {
            "And": {
              "Prefix": "media/",
              "ObjectSizeGreaterThan": 131072
            }
          },
          "Transitions": [
            {
              "Days": 30,
              "StorageClass": "GLACIER"
            }
          ],
          "Expiration": {
            "Days": 365
          }
        }
      ]
    },
    {
      "scenario": "valid-noncurrent-version-policy",
      "description": "Versões antigas com expiração apropriada e transição correta",
      "Rules": [
        {
          "ID": "NoncurrentVersionPolicy",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "db-backups/"
          },
          "NoncurrentVersionTransitions": [
            {
              "NoncurrentDays": 30,
              "StorageClass": "STANDARD_IA"
            },
            {
              "NoncurrentDays": 120,
              "StorageClass": "GLACIER"
            }
          ],
          "NoncurrentVersionExpiration": {
            "NoncurrentDays": 365
          }
        }
      ]
    },
    {
      "scenario": "valid-multipart-and-expiration",
      "description": "Política com MPU explícito e expiração de longa duração",
      "Rules": [
        {
          "ID": "LongTermUploadCleanup",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "uploads/"
          },
          "Expiration": {
            "Days": 365
          },
          "AbortIncompleteMultipartUpload": {
            "DaysAfterInitiation": 7
          }
        }
      ]
    },
    {
      "scenario": "valid-glacier-ir-transition",
      "description": "Transição correta para Glacier Instant Retrieval após 90 dias",
      "Rules": [
        {
          "ID": "GlacierIRLifecycle",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "cold-data/"
          },
          "Transitions": [
            {
              "Days": 30,
              "StorageClass": "STANDARD_IA"
            },
            {
              "Days": 90,
              "StorageClass": "GLACIER_IR"
            },
            {
              "Days": 180,
              "StorageClass": "DEEP_ARCHIVE"
            }
          ],
          "Expiration": {
            "Days": 2190
          }
        }
      ]
    },
    {
      "scenario": "valid-multi-rule-shared-prefix",
      "description": "Múltiplas regras habilitadas com filtros disjuntos e sem sobreposição perigosa",
      "Rules": [
        {
          "ID": "RetainHotData",
          "Status": "Enabled",
          "Filter": {
            "Prefix": "hot/"
          },
          "Expiration": {
            "Days": 30
          }
        },
        {
          "ID": "ArchiveOldHotData",
          "Status": "Enabled",
          "Filter": {
            "And": {
              "Prefix": "hot/",
              "ObjectSizeGreaterThan": 1048576
            }
          },
          "Transitions": [
            {
              "Days": 60,
              "StorageClass": "GLACIER"
            }
          ]
        }
      ]
    },
